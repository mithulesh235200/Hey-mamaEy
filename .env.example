# HeyMamaEy — Environment variables
# Copy this file to `.env` and fill in your values.
#
# Client-side (read by Vite at build time via import.meta.env.VITE_*):
#   - Create a project at https://supabase.com
#   - Go to Settings > API to get the Project URL and the `anon` / publishable key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here

# Edge Function secrets (set these in the Supabase dashboard, NOT in this file):
#   supabase functions secrets set invite-friend SUPABASE_URL=... SUPABASE_SERVICE_ROLE_KEY=... FCM_PROJECT_ID=... FCM_SERVICE_ACCOUNT=...
#
# The `invite-friend` Edge Function must be deployed for push invites to work:
#   supabase functions deploy invite-friend
